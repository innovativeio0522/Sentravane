{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Sentravane": {
    "ServerUrl": "http://localhost:5000",
    "EnrollmentToken": "DEFAULT_TOKEN",
    "RapidBurstThresholdCount": 40,
    "RapidBurstWindowSeconds": 5,
    "EnableCanaryTripwires": true,
    "EnableWfpQuarantine": true,
    "EnableForensicDump": true
  }
}
